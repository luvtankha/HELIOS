# Isolated SIH demonstration profile. Copy to .env and replace both secrets.
# Use only the repository's synthetic seed data and a dedicated throwaway database.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://helios_demo:replace-me@localhost:5432/helios_sih_demo?schema=public
ALLOW_DEMO_SEED=true
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_VOICE_MAX_DURATION_SECONDS=75
NEXT_PUBLIC_VOICE_MAX_FILE_BYTES=8000000
LOG_LEVEL=info
STORAGE_PROVIDER=local
STORAGE_PATH=./work/sih-demo-private-uploads
SESSION_TOKEN_SECRET=replace-with-a-random-demo-only-secret-at-least-32-characters
PATIENT_SESSION_TTL_SECONDS=14400
DOCTOR_SESSION_TTL_SECONDS=1800
ENABLE_DEMO_MODE=true
DEMO_MODE=true
DOCTOR_DEMO_ACCESS_CODE=replace-with-a-random-demo-only-access-code
ENABLE_VOICE=true
# Run pnpm speech:setup once. Use mock only for explicit canned-output tests.
SPEECH_PROVIDER=local
SPEECH_LOCAL_TIMEOUT_MS=120000
SPEECH_API_KEY=
ENABLE_OCR=true
DOCUMENT_OCR_PROVIDER=mock
DOCUMENT_MAX_FILE_BYTES=15000000
DOCUMENT_PROCESSING_TIMEOUT_MS=90000
DOCUMENT_PROCESSING_VERSION=phase6-v1
ENABLE_AI_INTERVIEW=false
ENABLE_SPECIALIZATION_ROUTING=true
CLINICAL_NLU_PROVIDER=rules
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=12000
ENABLE_RISK_ENGINE=false
ENABLE_AYUSH=true
BRIEF_RECENT_MONTHS=12
BRIEF_MAX_SYMPTOMS=6
BRIEF_MAX_CHANGES=6
BRIEF_MAX_DOCUMENTS=5
VOICE_MAX_DURATION_SECONDS=75
VOICE_MAX_FILE_BYTES=8000000
SPEECH_MODEL=gpt-4o-mini-transcribe
SPEECH_TIMEOUT_MS=30000
