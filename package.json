{
  "name": "helios",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "routing:seed": "node scripts/run-with-local-env.mjs routing:seed:direct",
    "routing:seed:direct": "pnpm --filter @helios/api exec tsx scripts/seed-routing.ts",
    "demo:routing:seed": "node scripts/run-with-demo-env.mjs routing:seed:direct",
    "speech:setup": "node scripts/setup-local-speech.mjs",
    "speech:smoke": "pnpm --filter @helios/api exec tsx scripts/smoke-local-speech.ts",
    "dev": "node scripts/run-with-local-env.mjs dev:services",
    "dev:services": "pnpm --filter @helios/shared build && concurrently -n web,api -c blue,green \"pnpm --filter @helios/web dev\" \"pnpm --filter @helios/api dev\"",
    "build": "pnpm --filter @helios/shared build && pnpm --filter @helios/api build && pnpm --filter @helios/web build",
    "start": "node scripts/run-with-local-env.mjs start:services",
    "start:services": "concurrently -n web,api -c blue,green \"pnpm --filter @helios/web start\" \"pnpm --filter @helios/api start\"",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm document-fixtures:generate && pnpm -r --if-present test",
    "test:unit": "pnpm document-fixtures:generate && pnpm --filter @helios/api test:unit && pnpm --filter @helios/web test:component",
    "test:integration": "pnpm --filter @helios/api test:integration",
    "test:db": "node scripts/run-database-tests.mjs",
    "test:api": "pnpm --filter @helios/api test:api",
    "test:e2e": "playwright test",
    "test:e2e:connected": "node scripts/run-with-demo-env.mjs test:e2e:connected:direct",
    "test:e2e:connected:direct": "playwright test --config playwright.connected.config.ts",
    "test:security": "pnpm --filter @helios/api test:security",
    "test:a11y": "playwright test --grep @a11y",
    "test:responsive": "playwright test --grep @responsive",
    "test:performance": "playwright test --grep @performance",
    "test:load": "pnpm build && concurrently --kill-others --success first \"node scripts/load-smoke.mjs --allow-local\" \"pnpm --filter @helios/web start\"",
    "test:coverage": "pnpm document-fixtures:generate && pnpm -r --if-present test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @helios/api db:generate",
    "db:migrate": "node scripts/run-with-local-env.mjs db:migrate:direct",
    "db:migrate:direct": "pnpm --filter @helios/api db:migrate",
    "db:check": "node scripts/run-with-local-env.mjs db:check:direct",
    "db:check:direct": "pnpm --filter @helios/api db:check",
    "db:validate": "pnpm --filter @helios/api db:validate",
    "db:seed": "pnpm --filter @helios/api db:seed",
    "demo:dev": "node scripts/run-with-demo-env.mjs dev:services",
    "demo:migrate": "node scripts/run-with-demo-env.mjs db:migrate:direct",
    "demo:seed": "node scripts/run-with-demo-env.mjs demo:seed:direct",
    "demo:seed:direct": "pnpm document-fixtures:generate && pnpm --filter @helios/api db:seed && pnpm --filter @helios/api demo:verify",
    "demo:reset": "node scripts/run-with-demo-env.mjs demo:reset:direct",
    "demo:reset:direct": "pnpm document-fixtures:generate && pnpm --filter @helios/api demo:reset-data && pnpm --filter @helios/api db:seed && pnpm --filter @helios/api demo:verify",
    "demo:verify": "node scripts/run-with-demo-env.mjs demo:verify:direct",
    "demo:verify:direct": "pnpm --filter @helios/api demo:verify",
    "dataset:generate": "node scripts/generate-helios-dataset.mjs",
    "dataset:validate": "node scripts/validate-helios-dataset.mjs",
    "document-fixtures:generate": "node scripts/generate-document-ai-fixtures.mjs",
    "document-ocr:smoke": "pnpm --filter @helios/api exec tsx scripts/smoke-local-image-ocr.ts",
    "locales:validate": "node scripts/validate-locales.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.35.4"
  }
}
