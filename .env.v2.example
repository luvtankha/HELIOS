# HELIOS v2 local/staging deployment. Replace every REQUIRED value.
POSTGRES_DB=helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=REQUIRED_LONG_RANDOM_DATABASE_PASSWORD
# Local Windows/Linux PostgreSQL profile used by pnpm dev:v2.
HELIOS_LOCAL_DATABASE=true
DATABASE_URL=postgresql://helios:REQUIRED_LONG_RANDOM_DATABASE_PASSWORD@127.0.0.1:55435/helios
HELIOS_FLYWAY_ENABLED=true
HELIOS_FLYWAY_BASELINE_ON_MIGRATE=false
SESSION_TOKEN_SECRET=REQUIRED_LONG_RANDOM_SESSION_SECRET
HELIOS_VOICE_RUNTIME_SECRET=REQUIRED_AT_LEAST_32_BYTE_RANDOM_SECRET
HELIOS_VOICE_CONTROL_SECRET=REQUIRED_SEPARATE_CONTROL_SECRET
HELIOS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_PATIENT_API_V2_URL=http://localhost:8080
NEXT_PUBLIC_VOICE_RUNTIME_URL=http://localhost:9090

# Use an AI Studio Free Tier project with billing disabled for quota-limited free use.
# API keys do not reveal billing tier; HELIOS cannot disable cloud billing itself.
HELIOS_VOICE_PROVIDER=gemini-live
GEMINI_API_KEY=
HELIOS_GEMINI_LIVE_MODEL=gemini-3.8-live
HELIOS_PATIENT_API_URL=http://localhost:8080
HELIOS_VOICE_PUBLIC_URI=http://localhost:9090
ENABLE_DEMO_MODE=false
DEMO_MODE=false
# The H01-H15 evidence gate applies to the experimental local Human-1 adapter.
# Gemini readiness reports configured credentials, not clinical/model benchmark approval.
HELIOS_VOICE_REQUIRE_BENCHMARK_APPROVAL=false
