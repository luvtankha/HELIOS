FROM node:22-bookworm-slim
WORKDIR /workspace
RUN corepack enable
ARG NEXT_PUBLIC_API_URL=http://localhost:5000
ARG NEXT_PUBLIC_PATIENT_API_V2_URL=http://localhost:8080
ARG NEXT_PUBLIC_VOICE_RUNTIME_URL=http://localhost:9090
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_PATIENT_API_V2_URL=${NEXT_PUBLIC_PATIENT_API_V2_URL} \
    NEXT_PUBLIC_VOICE_RUNTIME_URL=${NEXT_PUBLIC_VOICE_RUNTIME_URL}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
COPY packages/shared packages/shared
RUN pnpm --filter @helios/shared build && pnpm --filter @helios/web build
EXPOSE 3000
CMD ["pnpm","--filter","@helios/web","start"]
