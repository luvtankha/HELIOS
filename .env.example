NODE_ENV=development
PORT=5000
# Replace the role, password, and database with credentials provisioned on your PostgreSQL server.
# This example does not create a PostgreSQL role or database.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_DATABASE?schema=public
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_VOICE_MAX_DURATION_SECONDS=75
NEXT_PUBLIC_VOICE_MAX_FILE_BYTES=8000000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=12000
CLINICAL_NLU_PROVIDER=rules
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
ENABLE_VOICE=true
ENABLE_OCR=false
ENABLE_AI_INTERVIEW=false
ENABLE_SPECIALIZATION_ROUTING=false
ENABLE_RISK_ENGINE=false
ENABLE_AYUSH=false
ENABLE_DEMO_MODE=false
DEMO_MODE=false
SESSION_TOKEN_SECRET=replace-with-a-long-random-secret
PATIENT_SESSION_TTL_SECONDS=28800
DOCTOR_SESSION_TTL_SECONDS=3600
DOCTOR_DEMO_ACCESS_CODE=replace-this-demo-access-code
BRIEF_RECENT_MONTHS=12
BRIEF_MAX_SYMPTOMS=6
BRIEF_MAX_CHANGES=6
BRIEF_MAX_DOCUMENTS=5
# Run pnpm speech:setup once for local English/Hindi recognition.
SPEECH_PROVIDER=local
SPEECH_LOCAL_TIMEOUT_MS=120000
SPEECH_API_KEY=
SPEECH_MODEL=gpt-4o-mini-transcribe
SPEECH_TIMEOUT_MS=30000
VOICE_MAX_DURATION_SECONDS=75
VOICE_MAX_FILE_BYTES=8000000
DOCUMENT_MAX_FILE_BYTES=15000000
DOCUMENT_PROCESSING_TIMEOUT_MS=90000
DOCUMENT_OCR_PROVIDER=mock
DOCUMENT_PROCESSING_VERSION=phase6-v1
