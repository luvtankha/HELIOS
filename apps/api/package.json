{
  "name": "@helios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/interview-engine.test.ts tests/clinical-nlu.test.ts tests/timeline-engine.test.ts tests/comparison/comparison-engine.test.ts tests/clinical-brief/builder.test.ts tests/queue/service.test.ts tests/verification/service.test.ts tests/multilingual/language.test.ts",
    "test:integration": "node ../../scripts/assert-test-environment.mjs && vitest run integration.test.ts database.integration.test.ts",
    "test:api": "vitest run api.test.ts",
    "test:security": "vitest run tests/security tests/comparison/security.test.ts tests/document-ai/security.test.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "prisma db seed",
    "demo:reset-data": "tsx scripts/reset-demo.ts",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "db:validate": "cross-env DATABASE_URL=postgresql://schema:validation@localhost:5432/helios prisma validate"
  },
  "dependencies": {
    "@helios/shared": "workspace:*",
    "@prisma/client": "^6.15.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.3.289",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.34.0",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
